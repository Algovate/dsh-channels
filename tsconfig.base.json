{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "composite": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true
  }
}
