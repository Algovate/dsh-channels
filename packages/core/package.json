{
  "name": "@derekluo/dsh-channels",
  "version": "0.1.0",
  "description": "Chat channels for DeepSeek Harness agents: turn driving, interactions, media, gates, durable state and a status card. WeChat and Telegram adapters.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": "./dist/src/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./adapter-kit": "./dist/src/adapter-kit.js"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "bin"
  ],
  "bin": {
    "dsh-channels-doctor": "bin/doctor.mjs"
  },
  "scripts": {
    "build": "tsc -b",
    "build:client": "node ../../scripts/build-client.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4",
    "zod": "^4.6.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "manifestVersion": 1
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-storage-domain": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algovate/dsh-channels.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Algovate/dsh-channels",
  "bugs": {
    "url": "https://github.com/Algovate/dsh-channels/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "weixin",
    "telegram",
    "chat"
  ]
}
