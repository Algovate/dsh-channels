{
  "name": "@derekluo/dsh-channels-weixin",
  "version": "0.1.0",
  "description": "Weixin (personal WeChat, iLink Bot API) channel adapter for @derekluo/dsh-channels: text, images, files, video, voice transcription and document text.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vendor",
    "bin",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "optionalDependencies": {
    "silk-wasm": "^3.7.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algovate/dsh-channels.git",
    "directory": "packages/adapter-weixin"
  },
  "homepage": "https://github.com/Algovate/dsh-channels",
  "bugs": {
    "url": "https://github.com/Algovate/dsh-channels/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "wechat",
    "weixin",
    "personal-wechat",
    "chatbot",
    "channel",
    "adapter"
  ]
}
