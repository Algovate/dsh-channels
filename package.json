{
  "name": "dsh-channels-workspace",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "dsh-channels \u2014 chat channels for DSH agents (workspace root; not published)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/adapter-weixin packages/adapter-telegram",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo dist-test",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run test:build && node --test --test-concurrency=4 \"dist-test/test/**/*.test.js\"",
    "check": "npm test",
    "doctor": "node packages/core/bin/doctor.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
